From bafd13618b4dee3e879801d6f02aca48135b863e Mon Sep 17 00:00:00 2001
From: skygunner <skygunner@users.noreply.github.com>
Date: Mon, 26 Oct 2026 06:47:37 +1000
Subject: [PATCH] gateway: a union of objects inside a typed $ref target is
 given object for Kimi (#3566)

Kimi Code refused a tool whose schema holds a typed $ref target with an
untyped oneOf of objects inside it: 400 "tools.function.parameters is not
a valid moonshot flavored json schema, details: <At path
'properties.x': detected infinite recursion without termination
condition>" -- though the reporter's minimal schema has no cycle, and
typing that union object alone made the same route answer 200. Kimi
expands the target and refuses the union the same way it refuses an
untyped target.

Root cause: collectRefTargets only typed the $ref target itself, and
skipped a target that already had a type, so nothing looked inside it.
Inside a typed target it now walks the target and gives each oneOf that
has no type and whose every branch is an object the type object
(objectUnions). A union of other types, a union whose branches say
nothing, an anyOf (Kimi refuses a type beside one), and a branch only a
cycle resolves (schemaTypes' existing depth bound returns nothing) are
left as they were, and every other provider's schema is untouched. The
body is still built rather than written into, so the caller's bytes stay
as they were.

RED -> GREEN: TestKimiTypedRefObjectUnion drives /v1/chat/completions and
/v1/messages through the gateway handler with the reporter's exact
minimal parameters plus the neighbouring shapes, and asserts the exact
schema sent to api.kimi.com/coding. At 01468003 (test kept,
kimi_schema.go as before):
  FAIL kimi_typed_ref_union_test.go:91: /v1/chat/completions kimi was
  sent: ..."y":{"oneOf":[...]}... want: ..."y":{"type":"object","oneOf":...}
With the change both new tests pass. TestKimiToolRefTypes and
TestKimiToolEnumTypes, which pin the existing typing and its negatives,
still pass.

Run at this head (GOTOOLCHAIN=go1.26.8, temp HOME, pinned Go caches):
  go test -tags nogui ./internal/gateway/... -count=1
  go vet ./...                                          exit 0
  GOOS=linux GOARCH=amd64 go vet -tags nogui ./...      exit 0
  GOOS=windows GOARCH=amd64 go vet ./...                exit 0
  go build ./...                                        exit 0
  GOOS=linux GOARCH=amd64 go build -tags nogui ./...    exit 0
  GOOS=windows GOARCH=amd64 go build ./...              exit 0
  gofmt -l on the changed files                         empty

Not tried: the reporter's real REA toolset (198 tools, 55 union sites)
and the live Kimi Code endpoint, which needs a real key; the fixture is
their minimal function-parameters JSON, at the schema-conversion level.
---
 internal/gateway/kimi_schema.go               |  37 +++++-
 internal/gateway/kimi_typed_ref_union_test.go | 117 ++++++++++++++++++
 2 files changed, 150 insertions(+), 4 deletions(-)
 create mode 100644 internal/gateway/kimi_typed_ref_union_test.go

diff --git a/internal/gateway/kimi_schema.go b/internal/gateway/kimi_schema.go
index 8d698c32..6de0cbf2 100644
--- a/internal/gateway/kimi_schema.go
+++ b/internal/gateway/kimi_schema.go
@@ -285,7 +285,9 @@ func kimiToolRefTypes(p provider.Provider, to provider.Protocol, body []byte) []
 
 // collectRefTargets adds, for each local $ref under node (a schema of the
 // tool schema root) whose target Kimi would refuse untyped, where the
-// target opens and the type it is given.
+// target opens and the type it is given; inside a target that has a type,
+// each oneOf of objects with none is given object, which Kimi expands and
+// refuses the same way (#3566, objectUnions).
 func collectRefTargets(body []byte, root, node gjson.Result, ins *[]typeInsert) {
 	walkSchema(node, func(s gjson.Result) {
 		ref := s.Get(`\$ref`)
@@ -293,11 +295,38 @@ func collectRefTargets(body []byte, root, node gjson.Result, ins *[]typeInsert)
 			return
 		}
 		t, ok := refTarget(root, ref.String())
-		if !ok || !t.IsObject() || t.Index <= 0 || t.Index >= len(body) || body[t.Index] != '{' || !untypedForKimi(t) {
+		if !ok || !t.IsObject() || t.Index <= 0 || t.Index >= len(body) || body[t.Index] != '{' {
 			return
 		}
-		if typ := kimiSchemaType(root, t); typ != "" {
-			*ins = append(*ins, typeInsert{t.Index, typ})
+		if untypedForKimi(t) {
+			if typ := kimiSchemaType(root, t); typ != "" {
+				*ins = append(*ins, typeInsert{t.Index, typ})
+			}
+			return
+		}
+		objectUnions(root, t, ins)
+	})
+}
+
+// objectUnions adds, for each schema under node that is a oneOf with no
+// type whose every branch is an object, where it opens. Kimi expands a
+// typed $ref target and refuses an untyped union inside it — 400 "detected
+// infinite recursion without termination condition" — though the schema
+// has no cycle, and typing the union object passes (#3566). A union of
+// other types, one whose branches say nothing, an anyOf, and a union only
+// a cycle resolves (schemaTypes' depth runs out) are left as they were.
+func objectUnions(root, node gjson.Result, ins *[]typeInsert) {
+	walkSchema(node, func(s gjson.Result) {
+		if s.Get("type").Exists() || s.Get("anyOf").Exists() || !s.Get("oneOf").IsArray() {
+			return
+		}
+		for _, b := range s.Get("oneOf").Array() {
+			if ts := schemaTypes(root, b, 0); len(ts) != 1 || !ts["object"] {
+				return
+			}
+		}
+		if s.Index > 0 {
+			*ins = append(*ins, typeInsert{s.Index, `"object"`})
 		}
 	})
 }
diff --git a/internal/gateway/kimi_typed_ref_union_test.go b/internal/gateway/kimi_typed_ref_union_test.go
new file mode 100644
index 00000000..ed796b4b
--- /dev/null
+++ b/internal/gateway/kimi_typed_ref_union_test.go
@@ -0,0 +1,117 @@
+package gateway
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+	"github.com/yetone/magpie/internal/provider"
+)
+
+// #3566 (congee949): Kimi Code refused a tool whose typed $ref target had
+// an untyped oneOf of objects deeper inside it — 400 "not a valid moonshot
+// flavored json schema … At path 'properties.x': detected infinite
+// recursion without termination condition" — though the reporter's schema
+// has no cycle and typing the union with object alone made the same route
+// answer 200. A union of objects inside a typed $ref target is given the
+// type its branches imply. A union of other types, one whose branches
+// don't say, an anyOf, and a union that only leads back to itself are left
+// as they were, as is every other provider's schema.
+func TestKimiTypedRefObjectUnion(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	t.Setenv("XDG_CACHE_HOME", t.TempDir())
+	kimi, err := provider.FromPreset("kimi-code-cn")
+	if err != nil {
+		t.Fatal(err)
+	}
+	kimi.ID, kimi.Key, kimi.Models = "kimi", "k", []string{"m"}
+	for _, p := range []provider.Provider{kimi,
+		{ID: "other", Name: "Other", Key: "k", Chat: "https://other.test/v1", Anthropic: "https://other.test", Models: []string{"m"}},
+	} {
+		if err := provider.Save(p); err != nil {
+			t.Fatal(err)
+		}
+	}
+	got := map[string]string{}
+	s := New()
+	s.client = &http.Client{Transport: countTransport(func(r *http.Request) (*http.Response, error) {
+		b, _ := io.ReadAll(r.Body)
+		got[r.URL.Host+r.URL.Path] = string(b)
+		return &http.Response{StatusCode: 400, Header: http.Header{"Content-Type": {"application/json"}},
+			Body: io.NopCloser(strings.NewReader(`{"error":{"message":"no","type":"invalid_request_error"}}`))}, nil
+	})}
+	// the reporter's minimal parameters, with unions and a cycle beside
+	// them that must stay as they are
+	schema := `{"type":"object","properties":{"x":{"$ref":"#/$defs/X"},"z":{"$ref":"#/$defs/Z"}},` +
+		`"$defs":{"X":{"type":"object","properties":{` +
+		`"y":{"oneOf":[{"type":"object","properties":{"mode":{"type":"string","const":"a"}}},` +
+		`{"type":"object","properties":{"mode":{"type":"string","const":"b"}}}]},` +
+		`"mixed":{"oneOf":[{"type":"object","properties":{"n":{"type":"string"}}},{"type":"string"}]},` +
+		`"silent":{"oneOf":[{}]},` +
+		`"refs":{"anyOf":[{"type":"object","properties":{"n":{"type":"string"}}}]}},` +
+		`"required":["y"]},` +
+		`"Z":{"type":"object","properties":{"c":{"oneOf":[{"$ref":"#/$defs/Q"}]}},"required":["c"]},` +
+		`"Q":{"$ref":"#/$defs/Q"}}}`
+	want := strings.NewReplacer(
+		`"y":{`, `"y":{"type":"object",`,
+	).Replace(schema)
+	for _, r := range []struct{ path, tools, upstream, otherUp string }{
+		{"/v1/chat/completions", `"tools":[{"type":"function","function":{"name":"probe","parameters":%s}}]`, "api.kimi.com/coding/v1/chat/completions", "other.test/v1/chat/completions"},
+		{"/v1/messages", `"tools":[{"name":"probe","input_schema":%s}]`, "api.kimi.com/coding/v1/messages", "other.test/v1/messages"},
+	} {
+		for _, id := range []string{"kimi", "other"} {
+			clear(got)
+			body := `{"model":"` + id + `/m","messages":[{"role":"user","content":"Do not call tools. Reply exactly OK."}],"max_tokens":16,` +
+				strings.Replace(r.tools, "%s", schema, 1) + `}`
+			rec := httptest.NewRecorder()
+			s.Handler().ServeHTTP(rec, httptest.NewRequest("POST", r.path, strings.NewReader(body)))
+			up := r.upstream
+			if id == "other" {
+				up = r.otherUp
+			}
+			b, ok := got[up]
+			if !ok {
+				t.Fatalf("%s %s: nothing sent to %s, only %v (%d %s)", r.path, id, up, got, rec.Code, rec.Body)
+			}
+			if !json.Valid([]byte(b)) {
+				t.Fatalf("%s %s: invalid JSON sent:\n%s", r.path, id, b)
+			}
+			sent := gjson.Get(b, "tools.0.function.parameters")
+			if !sent.Exists() {
+				sent = gjson.Get(b, "tools.0.input_schema")
+			}
+			w := schema
+			if id == "kimi" {
+				w = want
+			}
+			if sent.Raw != w {
+				t.Errorf("%s %s was sent:\n%s\nwant:\n%s", r.path, id, sent.Raw, w)
+			}
+		}
+	}
+}
+
+// kimiToolRefTypes builds its body rather than writing into the one it is
+// given, so a request's own bytes — a cache's prefix, another route's —
+// stay as they were.
+func TestKimiTypedRefObjectUnionLeavesItsInput(t *testing.T) {
+	p, err := provider.FromPreset("kimi-code-cn")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body := []byte(`{"model":"m","tools":[{"type":"function","function":{"name":"probe","parameters":` +
+		`{"type":"object","properties":{"x":{"$ref":"#/$defs/X"}},` +
+		`"$defs":{"X":{"type":"object","properties":{"y":{"oneOf":[{"type":"object","properties":{"mode":{"const":"a"}}}]}}}}}}}]}`)
+	before := string(body)
+	out := kimiToolRefTypes(p, provider.Chat, body)
+	if string(body) != before {
+		t.Fatalf("the request's bytes changed: %s", body)
+	}
+	if gjson.GetBytes(out, "tools.0.function.parameters.$defs.X.properties.y.type").String() != "object" {
+		t.Fatalf("the union was not given object: %s", out)
+	}
+}
