+			n, err := unix.Readlinkat(fd, f.Name(), link)
+			if err != nil {
+				continue
+			}
+			b, ok := bytes.CutPrefix(link[:n], socketOpen)
+			if !ok {
+				continue
+			}
+			if b, ok := bytes.CutSuffix(b, socketClose); ok && inodes[string(b)] {
+				return true
+			}
+		}
+		if err != nil || len(fds) == 0 {
+			return false
 		}
 	}
