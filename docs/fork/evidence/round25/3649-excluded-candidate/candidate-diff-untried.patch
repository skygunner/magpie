+// magpieRun says whether pid runs one of magpie's own programs, by exe as
+// the system names it, or by comm when this user may not read the link
+// (another user's process). It is the first pass's filter alone: a
+// magpie's program is read again, by Executable, before anything of it is
+// ended.
+func magpieRun(pid int) bool {
+	if p, err := executable(pid); err == nil {
+		return IsMagpie(p)
+	}
+	b, err := os.ReadFile(filepath.Join(procDir(), strconv.Itoa(pid), "comm"))
+	return err == nil && IsMagpie(strings.TrimSpace(string(b)))
