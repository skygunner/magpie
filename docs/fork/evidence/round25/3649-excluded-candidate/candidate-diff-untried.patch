+// holds says whether pid holds one of inodes: every descriptor it has is
+// read, and the one naming one of the sockets is it. The directory is
+// listed a batch of names at a time and each name read through the
+// directory itself, so a process with millions of descriptors costs a
+// batch of names and one short read each, not the whole listing in memory
+// and a walk into /proc from its root for every descriptor. The context
+// ends the process between batches, never inside one.
+func holds(ctx context.Context, root string, pid int, inodes map[string]bool) bool {
+	d, err := os.Open(filepath.Join(root, strconv.Itoa(pid), "fd"))
+	if err != nil {
+		return false
+	}
+	defer d.Close()
+	fd := int(d.Fd())
