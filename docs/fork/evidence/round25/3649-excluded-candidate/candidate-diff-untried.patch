+// walkRest is the second pass: every pid no magpie of ours runs under, one
+// of them on a core at a time. The context ends the pass between
+// processes, and inside one between batches of its descriptors; the work
+// is drained either way, so no sender is left waiting for it.
+func walkRest(ctx context.Context, root string, pids, rest []int, inodes map[string]bool, held []bool) {
+	if len(rest) == 0 {
+		return
+	}
+	work := make(chan int)
+	var wg sync.WaitGroup
+	for range min(runtime.GOMAXPROCS(0), len(rest)) {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range work {
+				if ctx.Err() != nil {
+					continue
+				}
+				held[i] = holds(ctx, root, pids[i], inodes)
 			}
+		}()
+	}
+	for _, i := range rest {
+		work <- i
+	}
+	close(work)
+	wg.Wait()
+}
