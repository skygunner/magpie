From 1fe501d29a4f1c16cd8e70efbcfe386a1f300cc8 Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 05:56:31 +1000
Subject: [PATCH] gui: Try now lifts the rest of the magpie that serves the
 gateway (#3555, yetone)

A magpie that doesn't serve the gateway plays the serving one's routing
(OwnerTrace), but a rest is held in the serving process's memory. So
POST /api/gateway/unrest found this process's `served` nil and answered
400 "nothing to lift": Try now, in the provider's editor and on Routing,
left the rest where it was.

Now the lift is forwarded, as the trace is read. The gateway answers
POST /v1/magpie/unrest with the key rests by (Server.Unrest), behind the
same checks as the trace: this computer alone, never a held key. The console
asks it with gateway.OwnerUnrest, which is the trace's owner client: the
same loopback-only ownerURL, a short client and no auth header, since the
serving magpie takes loopback for the trust it needs. A serving magpie that
is too old for the route answers 404, and the page keeps today's 400
"nothing to lift", as it does when nothing answers at all.

Red, without the fix: go test -tags nogui ./internal/gui/ -run
TestTryNowLiftsARestOfTheServingMagpie -> trace_peer_test.go:165: 400
nothing to lift, where a fake owner answering the unrest endpoint got
nothing.

Green: same command, ok; ./internal/gui -count=1 ok (39s). New
./internal/gateway -run TestGatewayUnrestIsLoopbackOnly: the endpoint lifts
on loopback and refuses another machine and a proxied request. The gateway's
whole package at this base fails the same tests with and without the change
(TestClaudeClientCacheAbsentUnchanged, TestCodexFittedImagesPastTheBudget,
TestMarshalRawIsEncodingJSON, TestServeWSLListensBesideLoopback), checked
in a clean export of 6afbe3f3. gofmt -l clean; go vet -tags nogui
./internal/gateway/ ./internal/gui/ clean; go build -tags nogui ./... ok.
---
 internal/gateway/gateway.go         |  1 +
 internal/gateway/trace.go           | 71 +++++++++++++++++++++++++++++
 internal/gateway/trace_peer_test.go | 40 ++++++++++++++++
 internal/gui/trace.go               | 12 ++++-
 internal/gui/trace_peer_test.go     | 54 ++++++++++++++++++++++
 5 files changed, 177 insertions(+), 1 deletion(-)

diff --git a/internal/gateway/gateway.go b/internal/gateway/gateway.go
index c39371db..e240c19a 100644
--- a/internal/gateway/gateway.go
+++ b/internal/gateway/gateway.go
@@ -735,6 +735,7 @@ func (s *Server) Handler() http.Handler {
 	mux.HandleFunc("POST "+provider.RemoteRefreshPath, s.quotaCardsRefresh)
 	mux.HandleFunc("GET /v1/magpie/route", s.sessionRoute)
 	mux.HandleFunc("GET /v1/magpie/trace", s.gatewayTrace)
+	mux.HandleFunc("POST /v1/magpie/unrest", s.gatewayUnrest)
 	mux.HandleFunc("GET /v1/magpie/concurrency", s.concurrency)
 	mux.HandleFunc("GET /v1/magpie/limit", s.keyLimit)
 	// a heap profile of this process, for magpie heap (loopback only)
diff --git a/internal/gateway/trace.go b/internal/gateway/trace.go
index f0039b5f..b66e6312 100644
--- a/internal/gateway/trace.go
+++ b/internal/gateway/trace.go
@@ -9,7 +9,9 @@ package gateway
 // values they are made with; nothing is worked out again afterwards.
 
 import (
+	"bytes"
 	"context"
+	"encoding/json"
 	"io"
 	"math"
 	"net"
@@ -751,6 +753,31 @@ func (s *Server) gatewayTrace(w http.ResponseWriter, r *http.Request) {
 	writeJSON(w, 200, map[string]any{"object": "trace", "now": time.Now(), "seq": st.Seq, "routes": st.Routes, "totals": st.Totals, "ids": st.IDs, "lifted": st.Lifted, "pid": os.Getpid(), "serves": Serves})
 }
 
+// gatewayUnrest lifts a rest of the magpie serving the gateway, for the
+// console of a magpie on this computer that doesn't serve it: the rest is
+// held in the serving magpie's memory, so lifting it anywhere else lifts
+// nothing (#3555, yetone). This computer alone, and never to a held key, as
+// the trace is.
+func (s *Server) gatewayUnrest(w http.ResponseWriter, r *http.Request) {
+	if !local(r) {
+		writeError(w, provider.Chat, http.StatusForbidden, "magpie's rests are lifted on this computer alone")
+		return
+	}
+	if refuseHeld(w, r, heldRefused) {
+		return
+	}
+	var in struct {
+		Key string `json:"key"`
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4<<10)
+	b, err := io.ReadAll(r.Body)
+	if err != nil || decodeJSON(b, &in) != nil || strings.TrimSpace(in.Key) == "" {
+		writeError(w, provider.Chat, http.StatusBadRequest, "unrest needs the key the account or model rests by")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"lifted": s.Unrest(strings.TrimSpace(in.Key))})
+}
+
 // ownerURL is the gateway's address on loopback, where the magpie serving
 // it is read by another magpie on this computer (OwnerTrace, OwnerLanes).
 // An address on another interface, or another host, gives "": the trace is
@@ -823,7 +850,51 @@ func OwnerTrace(ctx context.Context, after int64, wait time.Duration) (TraceStat
 	return TraceState{Seq: out.Seq, Routes: out.Routes, Totals: out.Totals, IDs: out.IDs, Lifted: out.Lifted, By: &TraceBy{Pid: out.Pid, Serves: out.Serves}}, true
 }
 
+// OwnerUnrest lifts the rest of key in the magpie serving the gateway's
+// address, for a console that doesn't serve it (#3555, yetone): the rest is
+// held there, so this magpie's own Unrest lifts nothing. ok is false when
+// nothing answers there, a magpie too old to lift a rest of another's, or
+// one that refuses — the page then says there is nothing to lift, as before.
+func OwnerUnrest(ctx context.Context, key string) (lifted, ok bool) {
+	base := ownerURL()
+	if base == "" || strings.TrimSpace(key) == "" {
+		return false, false
+	}
+	body, err := json.Marshal(map[string]string{"key": strings.TrimSpace(key)})
+	if err != nil {
+		return false, false
+	}
+	// a lifted rest is answered at once; a hung magpie is let go, and the
+	// page at once when it stops asking
+	c := &http.Client{Timeout: 5 * time.Second}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, base+"/v1/magpie/unrest", bytes.NewReader(body))
+	if err != nil {
+		return false, false
+	}
+	req.Header.Set("Content-Type", "application/json")
+	res, err := c.Do(req)
+	if err != nil {
+		return false, false
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return false, false
+	}
+	b, err := io.ReadAll(io.LimitReader(res.Body, 1<<12))
+	if err != nil {
+		return false, false
+	}
+	var out struct {
+		Lifted bool `json:"lifted"`
+	}
+	if decodeJSON(b, &out) != nil {
+		return false, false
+	}
+	return out.Lifted, true
+}
+
 // OwnerLanes reads the lanes of the magpie serving the gateway's address, for
+
 // a console that doesn't serve it (the providers' rows show the same pills
 // wherever the gateway runs). ok is false when nothing answers there. It is
 // asked on every state read, so it waits no longer than ServedBy does.
diff --git a/internal/gateway/trace_peer_test.go b/internal/gateway/trace_peer_test.go
index 4b9a71df..ebcd7be1 100644
--- a/internal/gateway/trace_peer_test.go
+++ b/internal/gateway/trace_peer_test.go
@@ -2,8 +2,10 @@ package gateway
 
 import (
 	"encoding/json"
+	"net/http"
 	"net/http/httptest"
 	"os"
+	"strings"
 	"testing"
 )
 
@@ -97,3 +99,41 @@ func TestOwnerReadOnLoopbackAlone(t *testing.T) {
 		t.Error("lanes read from another host")
 	}
 }
+
+// The unrest of another magpie's console is answered here, where the rest
+// is held, and here alone (#3555, yetone): it forgets how long an account
+// or model sits out, which a magpie on this computer may ask.
+func TestGatewayUnrestIsLoopbackOnly(t *testing.T) {
+	h := New().Handler()
+	rest := func(r *http.Request) *http.Request {
+		r.RemoteAddr = "127.0.0.1:50123"
+		return r
+	}
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, rest(httptest.NewRequest("POST", "/v1/magpie/unrest", strings.NewReader(`{"key":"acct-a"}`))))
+	if w.Code != 200 || !strings.Contains(w.Body.String(), `"lifted":false`) {
+		t.Fatalf("%d %s", w.Code, w.Body)
+	}
+	// a body that names no key lifts nothing
+	w = httptest.NewRecorder()
+	h.ServeHTTP(w, rest(httptest.NewRequest("POST", "/v1/magpie/unrest", strings.NewReader(`{}`))))
+	if w.Code != 400 {
+		t.Fatalf("%d %s", w.Code, w.Body)
+	}
+	// another machine, and a request a proxy here handed on: refused
+	for _, r := range []*http.Request{
+		httptest.NewRequest("POST", "/v1/magpie/unrest", strings.NewReader(`{"key":"acct-a"}`)),
+		rest(httptest.NewRequest("POST", "/v1/magpie/unrest", strings.NewReader(`{"key":"acct-a"}`))),
+	} {
+		if r.RemoteAddr == "" {
+			r.RemoteAddr = "192.168.0.9:50123"
+		} else {
+			r.Header.Set("X-Forwarded-For", "203.0.113.7")
+		}
+		w := httptest.NewRecorder()
+		h.ServeHTTP(w, r)
+		if w.Code != 403 {
+			t.Fatalf("unrest reached from %s: %d %s", r.RemoteAddr, w.Code, w.Body)
+		}
+	}
+}
diff --git a/internal/gui/trace.go b/internal/gui/trace.go
index 6b385f48..d9366528 100644
--- a/internal/gui/trace.go
+++ b/internal/gui/trace.go
@@ -392,7 +392,17 @@ func traceRoutes(mux *http.ServeMux) {
 			Key string `json:"key"`
 		}
 		gw := served.Load()
-		if json.NewDecoder(r.Body).Decode(&in) != nil || in.Key == "" || gw == nil {
+		if json.NewDecoder(r.Body).Decode(&in) != nil || in.Key == "" {
+			http.Error(rw, "nothing to lift", http.StatusBadRequest)
+			return
+		}
+		if gw == nil {
+			// another magpie serves the gateway, and the rest it holds is
+			// lifted there: this one's own memory has none (#3555, yetone)
+			if lifted, ok := gateway.OwnerUnrest(r.Context(), in.Key); ok {
+				writeJSON(rw, map[string]bool{"lifted": lifted})
+				return
+			}
 			http.Error(rw, "nothing to lift", http.StatusBadRequest)
 			return
 		}
diff --git a/internal/gui/trace_peer_test.go b/internal/gui/trace_peer_test.go
index c23476c2..611e2b06 100644
--- a/internal/gui/trace_peer_test.go
+++ b/internal/gui/trace_peer_test.go
@@ -2,10 +2,12 @@ package gui
 
 import (
 	"encoding/json"
+	"io"
 	"net"
 	"net/http"
 	"net/http/httptest"
 	"path/filepath"
+	"strings"
 	"testing"
 )
 
@@ -122,3 +124,55 @@ func TestConsoleKeepsTheNoticeFromAnOlderGateway(t *testing.T) {
 		t.Fatalf("an older gateway's routing was played as this console's own: %s", w.Body)
 	}
 }
+
+// A rest is held in the memory of the magpie that serves the gateway, so
+// the console of one that doesn't must ask it to lift one: Try now answered
+// 400 "nothing to lift" and lifted nothing where the routing is decided
+// (#3555, yetone).
+func TestTryNowLiftsARestOfTheServingMagpie(t *testing.T) {
+	h := t.TempDir()
+	t.Setenv("HOME", h)
+	t.Setenv("USERPROFILE", h)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(h, ".config"))
+	t.Setenv("XDG_CACHE_HOME", filepath.Join(h, ".cache"))
+	t.Setenv("XDG_DATA_HOME", filepath.Join(h, ".local", "share"))
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("MAGPIE_ADDR", ln.Addr().String())
+	var asked []byte
+	other := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case r.URL.Path == "/v1/magpie/unrest" && r.Method == "POST":
+			asked, _ = io.ReadAll(r.Body)
+			w.Write([]byte(`{"lifted":true}`))
+		default:
+			http.NotFound(w, r)
+		}
+	})}
+	go other.Serve(ln)
+	defer other.Close()
+	served.Store(nil)
+	t.Cleanup(func() { served.Store(nil) })
+
+	mux := http.NewServeMux()
+	traceRoutes(mux)
+	w := httptest.NewRecorder()
+	mux.ServeHTTP(w, httptest.NewRequest("POST", "/api/gateway/unrest", strings.NewReader(`{"key":"acct-b"}`)))
+	if w.Code != 200 || !strings.Contains(w.Body.String(), `"lifted":true`) {
+		t.Fatalf("%d %s", w.Code, w.Body)
+	}
+	if strings.TrimSpace(string(asked)) != `{"key":"acct-b"}` {
+		t.Errorf("the serving magpie was asked %q", asked)
+	}
+
+	// nothing answers there: the page is told as before
+	other.Close()
+	w = httptest.NewRecorder()
+	mux.ServeHTTP(w, httptest.NewRequest("POST", "/api/gateway/unrest", strings.NewReader(`{"key":"acct-b"}`)))
+	if w.Code != 400 || !strings.Contains(w.Body.String(), "nothing to lift") {
+		t.Fatalf("%d %s", w.Code, w.Body)
+	}
+}
-- 
