diff --git a/internal/agentplug/reload_imports_test.go b/internal/agentplug/reload_imports_test.go
new file mode 100644
index 00000000..cfcf6e59
--- /dev/null
+++ b/internal/agentplug/reload_imports_test.go
@@ -0,0 +1,61 @@
+package agentplug
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// use makes plugins.json list one agent plugin in a folder of its own,
+// with files beside its entry, and loads it afresh.
+func use(t *testing.T, dir string) {
+	t.Helper()
+	if err := os.MkdirAll(settings.Dir(), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	b, _ := json.Marshal(plugin.List{Plugins: []plugin.Entry{{Spec: dir}}})
+	if err := os.WriteFile(filepath.Join(settings.Dir(), "plugins.json"), b, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	Reload()
+	t.Cleanup(func() {
+		os.Remove(filepath.Join(settings.Dir(), "plugins.json"))
+		Reload()
+	})
+}
+
+// An agent module can import files beside it (jsmod.Compile reads them),
+// but only the entry's own time and size were stamped, so an edit to an
+// imported file never reloaded the agent: the old name kept showing until
+// the entry or plugins.json changed (#3723). The files the module imports
+// are stamped too, so rewriting one reloads.
+func TestReloadOnImportedChange(t *testing.T) {
+	dir := t.TempDir()
+	os.WriteFile(filepath.Join(dir, "package.json"), []byte(`{"name":"t","magpie":{"agent":"./agent.js"}}`), 0o644)
+	os.WriteFile(filepath.Join(dir, "name.js"), []byte(`export const name = "Before";`), 0o644)
+	os.WriteFile(filepath.Join(dir, "agent.js"), []byte(`
+import { name } from "./name.js";
+export const agent = { id: "t", name, bin: "t", config: "~/.t.yml", model: "model" };
+export function connect() { return { k: "v" }; }`), 0o644)
+	use(t, dir)
+
+	list, errs := List()
+	if len(list) != 1 || list[0].Desc.Name != "Before" {
+		t.Fatalf("listed %+v %v", list, errs)
+	}
+	// only the imported file changes: a later time, the same size
+	imported := filepath.Join(dir, "name.js")
+	os.WriteFile(imported, []byte(`export const name = "After";`), 0o644)
+	later := time.Now().Add(time.Second)
+	os.Chtimes(imported, later, later)
+	nextCheck.Store(0)
+	list, errs = List()
+	if len(list) != 1 || list[0].Desc.Name != "After" {
+		t.Fatalf("an imported change didn't reload: %+v %v", list, errs)
+	}
+}
diff --git a/internal/jsmod/jsmod.go b/internal/jsmod/jsmod.go
index eea4e97d..8ffe50a9 100644
--- a/internal/jsmod/jsmod.go
+++ b/internal/jsmod/jsmod.go
@@ -13,21 +13,45 @@ import (
 	"github.com/Calcium-Ion/moejs"
 )
 
+// File is a module's file as it was read: its path and its time and size
+// from just before, so a loader can tell it changed.
+type File struct {
+	Path            string
+	ModTimeUnixNano int64
+	Size            int64
+}
+
 // Compile compiles the module in file and the modules it imports, which
 // are files under root: there is no node_modules here, so a package is
 // bundled into the module. what names the kind of module in an error
-// ("a middleware").
-func Compile(root, file, what string) (*moejs.Module, error) {
-	src, err := os.ReadFile(file)
+// ("a middleware"). The files it read are given back besides the module,
+// the entry included, so a loader can load the module again when one of
+// them changed (#3723): the imports are otherwise invisible to it, and
+// an edit to an imported file kept running until the entry changed.
+func Compile(root, file, what string) (*moejs.Module, []File, error) {
+	var read []File
+	one := func(p string) (string, error) {
+		fi, err := os.Stat(p)
+		if err != nil {
+			return "", err
+		}
+		read = append(read, File{Path: p, ModTimeUnixNano: fi.ModTime().UnixNano(), Size: fi.Size()})
+		b, err := os.ReadFile(p)
+		if err != nil {
+			return "", err
+		}
+		return string(b), nil
+	}
+	src, err := one(file)
 	if err != nil {
-		return nil, err
+		return nil, nil, err
 	}
-	entry, err := moejs.Compile(file, string(src))
+	entry, err := moejs.Compile(file, src)
 	if err != nil {
-		return nil, err
+		return nil, nil, err
 	}
 	mods := map[string]*moejs.Module{file: entry}
-	return moejs.Link(entry, func(ref moejs.Referrer, spec string) (*moejs.Module, error) {
+	mod, err := moejs.Link(entry, func(ref moejs.Referrer, spec string) (*moejs.Module, error) {
 		if !strings.HasPrefix(spec, "./") && !strings.HasPrefix(spec, "../") {
 			return nil, fmt.Errorf("%q: %s imports only files beside it; bundle packages into it", spec, what)
 		}
@@ -42,15 +66,16 @@ func Compile(root, file, what string) (*moejs.Module, error) {
 		if m, ok := mods[p]; ok {
 			return m, nil
 		}
-		src, err := os.ReadFile(p)
+		src, err := one(p)
 		if err != nil {
 			return nil, err
 		}
-		m, err := moejs.Compile(p, string(src))
+		m, err := moejs.Compile(p, src)
 		if err != nil {
 			return nil, err
 		}
 		mods[p] = m
 		return m, nil
 	})
+	return mod, read, err
 }
