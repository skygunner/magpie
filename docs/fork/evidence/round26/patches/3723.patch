 	return s
 }
 
+// importsOf is the files the middleware in file imported when it last
+// loaded, kept for stamp: which files to look at, so that its once-a-second
+// look costs a stat of each and not what a load does.
+var importsMemo struct {
+	sync.Mutex
+	m map[string][]jsmod.File
+}
+
+func importsOf(file string) []jsmod.File {
+	importsMemo.Lock()
+	defer importsMemo.Unlock()
+	return importsMemo.m[file]
+}
+
+// keepImports notes the files the middleware in file imports, as they were
+// read when it loaded, so the stamp looks at each of them.
+func keepImports(file string, files []jsmod.File) {
+	importsMemo.Lock()
+	if importsMemo.m == nil {
+		importsMemo.m = map[string][]jsmod.File{}
+	}
+	importsMemo.m[file] = files
+	importsMemo.Unlock()
+}
+
 // compile compiles the middleware in file and the modules it imports,
 // which are files beside it: there is no node_modules here, so a package
 // is bundled into the middleware.
@@ -176,11 +213,12 @@ func compile(e plugin.Entry, file string) (*mw, error) {
 	if t := plugin.Target(e.Spec); t != file {
 		root = t
 	}
-	mod, err := jsmod.Compile(root, file, "a middleware")
+	mod, files, err := jsmod.Compile(root, file, "a middleware")
 	if err != nil {
 		return nil, err
 	}
 	m := &mw{spec: e.Spec, name: plugin.Name(e.Spec), mod: mod, options: []byte("{}")}
+	keepImports(file, files)
 	if len(e.Options) > 0 {
 		if b, err := jsonMarshal(e.Options); err == nil {
 			m.options = b
diff --git a/internal/middleware/reload_imports_test.go b/internal/middleware/reload_imports_test.go
new file mode 100644
index 00000000..6de6b310
--- /dev/null
+++ b/internal/middleware/reload_imports_test.go
@@ -0,0 +1,47 @@
+package middleware
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/yetone/magpie/internal/plugin"
+)
+
+// A middleware's module can import files beside it (jsmod.Compile reads
+// them), but only the entry's own time and size were stamped, so an edit
+// to an imported file never reloaded the middleware: the old code kept
+// running until the entry or plugins.json changed (#3723). The files the
+// module imports are stamped too, so rewriting one reloads.
+func TestReloadOnImportedChange(t *testing.T) {
+	dir := t.TempDir()
+	os.WriteFile(filepath.Join(dir, "package.json"), []byte(`{"name":"names","magpie":{"middleware":"./index.js"}}`), 0o644)
+	os.WriteFile(filepath.Join(dir, "names.js"), []byte(`export const names = {"m1": "one"};`), 0o644)
+	os.WriteFile(filepath.Join(dir, "index.js"), []byte(`
+import { names } from "./names.js";
+export function onRequest(b) { b.v = names[b.model]; return b; }`), 0o644)
+	entry := plugin.Entry{Spec: dir}
+	if f, _ := plugin.Middleware(dir); f == "" {
+		t.Fatal("no middleware in the package")
+	}
+	use(t, entry)
+	run := func() string {
+		r := Begin(info())
+		defer r.End()
+		b, _ := r.Request([]byte(`{"model":"m1"}`))
+		return string(b)
+	}
+	if got := run(); got != `{"model":"m1","v":"one"}` {
+		t.Fatal(got)
+	}
+	// only the imported file changes: a later time, the same size
+	imported := filepath.Join(dir, "names.js")
+	os.WriteFile(imported, []byte(`export const names = {"m1": "two"};`), 0o644)
+	later := time.Now().Add(time.Second)
+	os.Chtimes(imported, later, later)
+	nextCheck.Store(0)
+	if got := run(); got != `{"model":"m1","v":"two"}` {
+		t.Fatal("an imported change didn't reload:", got)
+	}
+}
