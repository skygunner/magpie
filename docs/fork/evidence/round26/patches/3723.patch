 internal/agentplug/reload_imports_test.go  | 61 ++++++++++++++++++++++
 internal/jsmod/jsmod.go                    | 43 +++++++++++----
 internal/middleware/middleware.go          | 42 ++++++++++++++-
 internal/middleware/reload_imports_test.go | 47 +++++++++++++++++
 5 files changed, 216 insertions(+), 12 deletions(-)
