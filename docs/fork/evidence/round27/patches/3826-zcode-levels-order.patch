From f26769d7e93bd636c8e6fc4d11969c58fd2afaad Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:42:19 +1000
Subject: [PATCH] agent: ZCode variants are written in rank order (#3826,
 royluoh)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause: zcodeLevels kept the catalog's Efforts order verbatim after
mapping "none" → "disabled" and deduping, so the variants magpie wrote into
ZCode's config.json and provider_config.json were whatever the catalog
sent — e.g. xhigh, minimal, low, medium, high — and the picker showed them
in that jumble.

zcodeLevels now sorts by a rank: disabled, minimal, low, medium, high,
xhigh, max, ultra, persistent. Unknown levels keep their arrival order
after the known ones via a stable sort. Both
zcodeProviderJSON (~150) and zcodeRules (~467) use this slice, so both
generated files get the same order.

TestZCodeLevelsAreWrittenInRankOrder shows the rank ordering and the
unknown-level stable behaviour. The existing GLM case
TestZCodeOutputAndReasoning asserts
variants ["disabled","low","high","max"] and stays green.

Red (unmodified code, test at zcode_test.go:267):
  go test -tags nogui ./internal/agent/ -count=1 -run TestZCodeLevelsAreWrittenInRankOrder
  --- FAIL: zcodeLevels([xhigh minimal low medium high]) = [xhigh minimal low medium high], want [minimal low medium high xhigh]

Green: same command passes. The catalog-level test TestZCodeOutputAndReasoning
passes as well.
---
 internal/agent/zcode.go      | 21 +++++++++++++++++++++
 internal/agent/zcode_test.go | 19 +++++++++++++++++++
 2 files changed, 40 insertions(+)

diff --git a/internal/agent/zcode.go b/internal/agent/zcode.go
index b34002fb..3756e2a6 100644
--- a/internal/agent/zcode.go
+++ b/internal/agent/zcode.go
@@ -10,6 +10,7 @@ import (
 	"path/filepath"
 	"runtime"
 	"slices"
+	"sort"
 	"strings"
 
 	"github.com/yetone/magpie/internal/appdir"
@@ -326,6 +327,12 @@ const zcodeMaxOutput = 128000
 
 func zcodeOutput(n int) int { return min(n, zcodeMaxOutput) }
 
+// zcodeLevelRank is ZCode's levels in the order its picker shows them.
+var zcodeLevelRank = map[string]int{
+	"disabled": 0, "minimal": 1, "low": 2, "medium": 3, "high": 4,
+	"xhigh": 5, "max": 6, "ultra": 7, "persistent": 8,
+}
+
 // zcodeLevels are a model's reasoning levels as ZCode names them: "disabled"
 // turns thinking off, any other is sent as the effort.
 func zcodeLevels(efforts []string) []string {
@@ -338,6 +345,20 @@ func zcodeLevels(efforts []string) []string {
 			out = append(out, e)
 		}
 	}
+	// the file ZCode reads is generated by magpie, so the order magpie
+	// writes it is the only one the user gets in its picker: known levels
+	// in rank order, a level magpie doesn't know keeping its arrival place
+	// after them (stable)
+	sort.SliceStable(out, func(i, j int) bool {
+		ri, rj := len(zcodeLevelRank), len(zcodeLevelRank)
+		if r, ok := zcodeLevelRank[out[i]]; ok {
+			ri = r
+		}
+		if r, ok := zcodeLevelRank[out[j]]; ok {
+			rj = r
+		}
+		return ri < rj
+	})
 	return out
 }
 
diff --git a/internal/agent/zcode_test.go b/internal/agent/zcode_test.go
index 63837df8..7794b901 100644
--- a/internal/agent/zcode_test.go
+++ b/internal/agent/zcode_test.go
@@ -250,6 +250,25 @@ func TestZCodeOutputAndReasoning(t *testing.T) {
 	}
 }
 
+// #3826: the levels magpie writes into ZCode's generated file are the only
+// order the user's picker ever shows, so they go out in rank order — the
+// catalog's arrival order (GLM-4.6's before the fix) was a jumble.
+func TestZCodeLevelsAreWrittenInRankOrder(t *testing.T) {
+	for _, c := range []struct{ in, want []string }{
+		{[]string{"none", "low", "high", "max"}, []string{"disabled", "low", "high", "max"}},
+		{[]string{"xhigh", "minimal", "low", "medium", "high"}, []string{"minimal", "low", "medium", "high", "xhigh"}},
+		// a level magpie doesn't know keeps its arrival place after the
+		// known ones
+		{[]string{"deep", "high", "none", "low"}, []string{"disabled", "low", "high", "deep"}},
+		{[]string{"deep", "shallow"}, []string{"deep", "shallow"}},
+	} {
+		got := zcodeLevels(c.in)
+		if !slices.Equal(got, c.want) {
+			t.Errorf("zcodeLevels(%v) = %v, want %v", c.in, got, c.want)
+		}
+	}
+}
+
