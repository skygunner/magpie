From b16a0651ededfa3f391e28e87100c10a0507ab9b Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:41:01 +1000
Subject: [PATCH] gateway: an error after a reply began is said alone, not as a
 second message (#3792, JoeyWu-tech)

A reply cut by the loop guard (cutLoop) ends with streamError, which
builds a fresh encoder from an empty Request. That encoder's auto-start
guard (event, every protocol) took a KError for the reply's beginning and
opened a new message first: a Chat client that already had the reply
started saw a second "id":"chatcmpl-" chunk with a role delta, and the
error inside a message of its own. A KError now never auto-starts, so
only the error event goes out, as the passthrough path already said it;
the guard's other starts (KStart, and keepalive's own, which begins with
the request's model as #3728 pinned) are untouched.

Red: go test -tags nogui ./internal/gateway -count=1 -run
TestLoopEndsTheReplyOnEveryProtocol fails at the new chat assertion in
loop_guard_test.go (chatcmpl- found in the reply). Green: the same
command passes, and the full package keeps only the five failures that
fail at this base too (TestClaudeClientCacheAbsentUnchanged,
TestCodexFittedImagesPastTheBudget, TestMarshalRawIsEncodingJSON,
FuzzMarshalRaw, TestServeWSLListensBesideLoopback).
---
 internal/gateway/anthropic.go       |  3 ++-
 internal/gateway/chat.go            |  6 +++++-
 internal/gateway/gemini.go          |  3 ++-
 internal/gateway/loop_guard_test.go | 15 ++++++++++++++-
 internal/gateway/responses.go       |  3 ++-
 5 files changed, 25 insertions(+), 5 deletions(-)

diff --git a/internal/gateway/anthropic.go b/internal/gateway/anthropic.go
index 249a417f..012ffd2e 100644
--- a/internal/gateway/anthropic.go
+++ b/internal/gateway/anthropic.go
@@ -1566,7 +1566,8 @@ func (e *anthropicEncoder) sayCited(text string, cites []map[string]any, tail bo
 }
 
 func (e *anthropicEncoder) event(ev Event) {
-	if ev.Kind != KStart && !e.started {
+	// as chat's event: an error after the reply began is said alone (#3792)
+	if ev.Kind != KStart && ev.Kind != KError && !e.started {
 		e.start(Event{})
 	}
 	switch ev.Kind {
diff --git a/internal/gateway/chat.go b/internal/gateway/chat.go
index da6dfe7b..32a2f70c 100644
--- a/internal/gateway/chat.go
+++ b/internal/gateway/chat.go
@@ -1550,7 +1550,11 @@ func (e *chatEncoder) start(ev Event) {
 }
 
 func (e *chatEncoder) event(ev Event) {
-	if ev.Kind != KStart && !e.started {
+	// An error is not the reply's beginning: one said after the reply began
+	// (streamError, cutLoop) goes out alone, where auto-starting would open
+	// a second completion a client that already has one reads as another
+	// reply (#3792).
+	if ev.Kind != KStart && ev.Kind != KError && !e.started {
 		e.start(Event{})
 	}
 	switch ev.Kind {
