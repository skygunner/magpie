From e678dbc528a08e333318a268dbe2ce121bc93358 Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:40:50 +1000
Subject: [PATCH] gui: model picker names the group that unlists it, not the
 provider (#2746, kudi68)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Unlisted kept a model out of the agents' pickers for two reasons: its
provider is kept “Only through routing groups”, and a routing group
has Unlists on. Before, the page said “{provider} is used only through
routing groups …” for both reasons, and because the picker promotes the
current value's option to group:"" home:"Routing groups", it missed the
group via o.home === ROUTING_GROUPS, so a promoted group row reported
via empty and the note blamed the provider. The code now checks both o.group
and o.home when finding the via option, and the backend flags an
unlisted entry with ByGroup when the provider isn't the keeper
(!e.Provider.Unlisted). Front-end keptNote uses m.byGroup to choose the
new wording: “A routing group keeps {model} out of the lists: agents
reach it by picking {group}.” which names the group and drops the
provider sentence and “The group alone”. The two provider sentences
stay byte-identical, and translations for the new string are added in
all five languages with identical placeholders.

Verified: internal/gui/tests/unlisted-models.test.cjs gains a codex/
gpt-6.1-sol unlisted entry with ByGroup and groups ["group/night-shift"],
two groups with unlists:true, and a check that with the agent's field
set to magpie/group/night-shift the filter finds the kept row whose
note equals “A routing group keeps gpt-6.1-sol out of the lists: agents
reach it by picking night-shift.” and contains no “Codex”. Before the
fix, that note blamed Codex and the test fails at the note-assertion
(4/4 red); after it the four tests (chromium/webkit, en/zh) pass. i18n-
keys passes, core budget passes, go build -tags nogui ./... succeeds.
---
 internal/gui/api.go                         |  6 ++++-
 internal/gui/assets/app.js                  | 12 ++++++---
 internal/gui/assets/i18n.js                 |  4 +++
 internal/gui/tests/unlisted-models.test.cjs | 30 ++++++++++++++++++++-
 4 files changed, 47 insertions(+), 5 deletions(-)

diff --git a/internal/gui/api.go b/internal/gui/api.go
index c6700627..04a1c8c8 100644
--- a/internal/gui/api.go
+++ b/internal/gui/api.go
@@ -306,6 +306,10 @@ type unlistedJSON struct {
 	Provider string   `json:"provider"`
 	Icon     string   `json:"icon,omitempty"`
 	Groups   []string `json:"groups"`
+	// ByGroup: the provider isn't the one kept for routing groups — one of
+	// the groups above keeps this model out of the lists (Group.Unlists),
+	// so the page names that group instead of blaming the provider
+	ByGroup bool `json:"byGroup,omitempty"`
 }
 
 // unlistedModels lists provider.Unlisted for the page.
@@ -321,7 +325,7 @@ func unlistedModels() []unlistedJSON {
 		if gs == nil {
 			gs = []string{}
 		}
-		out = append(out, unlistedJSON{ID: e.ID, Name: e.Name, Provider: e.Provider.Name, Icon: e.Provider.Icon, Groups: gs})
+		out = append(out, unlistedJSON{ID: e.ID, Name: e.Name, Provider: e.Provider.Name, Icon: e.Provider.Icon, Groups: gs, ByGroup: !e.Provider.Unlisted})
 	}
 	return out
 }
diff --git a/internal/gui/assets/app.js b/internal/gui/assets/app.js
index e320d033..5ac6fe62 100644
--- a/internal/gui/assets/app.js
+++ b/internal/gui/assets/app.js
@@ -5519,14 +5519,20 @@ function keptNote(m) {
   const words = el("span", "kept-words");
   const model = m.name || m.id;
   words.append(el("b", "", model));
-  const via = m.groups.map((g) => pick.options.find((o) => o.ref === g && o.group === ROUTING_GROUPS)).filter(Boolean);
+  const via = m.groups.map((g) => pick.options.find((o) => o.ref === g && (o.group === ROUTING_GROUPS || o.home === ROUTING_GROUPS))).filter(Boolean);
   const act = el("button", "text action");
   if (via.length) {
-    words.append(el("span", "", t("{provider} is used only through routing groups: agents reach {model} by picking {group}.", { provider: m.provider, model, group: via.map((o) => o.label || o.value).join(", ") })));
+    words.append(el("span", "", m.byGroup
+      // one of the groups keeps it out of the lists (Group.Unlists): name
+      // that group, not the provider (#2746)
+      ? t("A routing group keeps {model} out of the lists: agents reach it by picking {group}.", { model, group: via.map((o) => o.label || o.value).join(", ") })
+      : t("{provider} is used only through routing groups: agents reach {model} by picking {group}.", { provider: m.provider, model, group: via.map((o) => o.label || o.value).join(", ") })));
     act.textContent = t("Pick {group}", { group: via[0].label || via[0].value });
     act.onclick = (ev) => { ev.stopPropagation(); commit(via[0].value); };
   } else {
-    words.append(el("span", "", t("{provider} is used only through routing groups, and {model} is in none, so no agent can use it. Make a group of it, or untick “Only through routing groups” in {provider}'s models.", { provider: m.provider, model })));
+    words.append(el("span", "", m.byGroup
+      ? t("A routing group keeps {model} out of the lists: agents reach it by picking {group}.", { model, group: m.groups.map((g) => g.replace("group/", "")).join(", ") })
+      : t("{provider} is used only through routing groups, and {model} is in none, so no agent can use it. Make a group of it, or untick “Only through routing groups” in {provider}'s models.", { provider: m.provider, model })));
     act.textContent = t("Make a routing group of it");
     act.dataset.feature = "routing"; // made on the Routing page
     act.onclick = (ev) => {
