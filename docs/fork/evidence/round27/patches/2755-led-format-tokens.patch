From b20f17d51b02a1a2f52083b9c7e2f4dfde0af1ce Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:13:09 +1000
Subject: [PATCH] gui: the tokens trend's tooltip says tokens the page's way
 (#2755, tianxia3111)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ledFormatLong's token branch went through ledNum (a thousand-separated
count, '15,522') where ledFormat beside it already sends tokens through
fmtN — '15.5K', or '1.6 万' with Settings' 万/亿 units on. The tooltip's
rows, its sums and the ranking all read it. The cost and speed branches
and the calls count are as they were.
---
 internal/gui/assets/app.js                    |  2 +-
 .../gui/tests/usage-ttft-rounding.test.cjs    | 34 +++++++++++++++++--
 2 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/internal/gui/assets/app.js b/internal/gui/assets/app.js
index e320d033..5695cff7 100644
--- a/internal/gui/assets/app.js
+++ b/internal/gui/assets/app.js
@@ -18350,7 +18350,7 @@ const ledRankValue = (m, x) => m === "speed" ? ledGroupSpeed(x)?.v || 0 : ledVal
 const ledPart = (m, x) => m === "speed" ? ledSpeed(x) : m === "cost" ? +x.cost || 0 : m === "calls" ? +x.calls || 0 : +x.tokens || 0;
 // a metric as its axis and its values say it
 const ledFormat = (m, v) => m === "cost" ? ledMoney(v) : m === "calls" || m === "speed" ? ledNum(Math.round(v)) : fmtN(Math.round(v));
-const ledFormatLong = (m, v) => m === "speed" ? (v > 0 ? t("{n} tok/s", { n: ledNum(Math.round(v)) }) : "—") : m === "cost" ? (fmtCost({ cost: v, unpriced: 0 }) || "—") : ledNum(Math.round(v));
+const ledFormatLong = (m, v) => m === "speed" ? (v > 0 ? t("{n} tok/s", { n: ledNum(Math.round(v)) }) : "—") : m === "cost" ? (fmtCost({ cost: v, unpriced: 0 }) || "—") : fmtN(Math.round(v));
 
 // an axis's top with four steps under it: round numbers, the top at least the largest value
 function ledAxis(max) {
diff --git a/internal/gui/tests/usage-ttft-rounding.test.cjs b/internal/gui/tests/usage-ttft-rounding.test.cjs
index 6d330195..03cec4c4 100644
--- a/internal/gui/tests/usage-ttft-rounding.test.cjs
+++ b/internal/gui/tests/usage-ttft-rounding.test.cjs
@@ -96,8 +96,8 @@ for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium",
 
         // the speed trend's tooltip, the report's
         await reader.click(p, p.locator("#ledMetric .opt").filter({ hasText: w.speed }));
-        await p.waitForTimeout(150);
-        const box = await p.locator("#ledChart rect.col.all").first().boundingBox();
+        await p.waitForTimeout(1500);
+        const box = await p.locator("#ledChart rect.col").first().boundingBox();
         await p.mouse.move(box.x + box.width / 2, box.y + box.height / 2);
         const tip = p.locator("#ledChart .tip");
         await tip.waitFor();
@@ -110,3 +110,33 @@ for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium",
     }
   });
 }
+
+// #2755 (tianxia3111): the tokens trend's tooltip said the raw
+// thousand-separated count (15,522) while the rest of the page formats
+// tokens the page's way — 15.5K, or 1.6 万 with Settings' 万/亿 units on.
+for (const engine of (process.env.BROWSER ? [process.env.BROWSER] : ["chromium", "webkit"])) {
+  test(engine + ": the tokens trend's tooltip says tokens the page's way", async (t) => {
+    const browser = await (engine === "webkit" ? webkit.launch() : chromium.launch({ channel: "chromium" }));
+    t.after(() => browser.close());
+    for (const lang of ["en", "zh"]) {
+      const ctx = await browser.newContext({ viewport: { width: 1100, height: 800 }, reducedMotion: "reduce" });
+      const p = await ctx.newPage();
+      p.setDefaultTimeout(5000);
+      await p.route("**/*", async (route) => {
+        const u = new URL(route.request().url());
+        if (u.pathname === "/boot.js") return route.fulfill({ contentType: "text/javascript", body: `window.bootPrefs = {lang:"${lang}",theme:"light",web:false,chineseUnits:${lang === "zh"}};` });
+        if (u.pathname === "/wails/runtime.js") return route.fulfill({ contentType: "text/javascript", body: "export const Window = {};" });
+        if (u.pathname.startsWith("/api/")) return route.fulfill({ json: {} });
+        const f = require("node:path").join("/w/internal/gui/assets", u.pathname === "/" ? "index.html" : u.pathname);
+        const ct = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css" }[require("node:path").extname(f)];
+        return route.fulfill({ body: await require("node:fs").promises.readFile(f), contentType: ct });
+      });
+      await p.goto("http://magpie.test/");
+      const got = await p.evaluate(() => ledFormatLong("tokens", 15522));
+      const want = "15.5K";
+      assert.notEqual(got, "15,522", "no raw thousand-separated count: " + got);
+      assert.equal(got, want, "tokens said the page's way: " + got + " (want " + want + ")");
+      await ctx.close();
+    }
+  });
+}
-- 
