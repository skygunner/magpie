From 38b8f9b979ad2916f5a81a23c219a4dc067817ac Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 17:10:16 +1000
Subject: [PATCH] plugin: a gateway request hook alone shows in discovery
 (#3821, MengXiangxi)

readTagged read only magpie.middleware, magpie.agent and magpie.page from
a tagged repository's package.json; a package that ships only magpie.hooks
(an asynchronous gateway request hook, which gateway.go's Gateway and
store.go's notPlugin both recognise) had no kind and fell through to the
entry-file check, and with no index.js to load it was dropped from the
list with keep=false and done=true, silently: neither listed nor counted
as missing.

Now the magpie block's hooks field is read, and a package with no main,
no exports and a non-empty hooks is kinded middleware, the kind the other
gateway plugins carry, so the GUI's kindOf keeps working, and no entry
file is looked for (it has none, as GatewayOnly already holds).

Verified: internal/plugin/testdata/github/raw/someone/hooks-only's
package.json is the reporter's literal shape (magpie.hooks only, no
main/exports); TestTaggedRepos fails on the base with the hook-only repo
absent from the list, and passes with the fix, together with the rest of
the package tests. The 502-on-unreadable-entry policy is left as it is.

Without the fix: go test -tags nogui ./internal/plugin/ -run 'TestTaggedRepos$'
fails at github_test.go:203 (hooks-only not in the list).
---
 internal/plugin/github.go                     |  7 +++
 internal/plugin/github_test.go                | 47 ++++++++++++-------
 .../raw/someone/hooks-only/main/package.json  |  1 +
 3 files changed, 37 insertions(+), 18 deletions(-)
 create mode 100644 internal/plugin/testdata/github/raw/someone/hooks-only/main/package.json

diff --git a/internal/plugin/github.go b/internal/plugin/github.go
index 1d8d07a0..1f43acbf 100644
--- a/internal/plugin/github.go
+++ b/internal/plugin/github.go
@@ -390,6 +390,7 @@ func readTagged(pc context.Context, t Tagged, branch string) (Tagged, bool, bool
 		Exports json.RawMessage `json:"exports"`
 		Magpie  struct {
 			Middleware string `json:"middleware"`
+			Hooks      string `json:"hooks"`
 			Agent      string `json:"agent"`
 			Icon       string `json:"icon"`
 			Page       struct {
@@ -412,6 +413,12 @@ func readTagged(pc context.Context, t Tagged, branch string) (Tagged, bool, bool
 			t.Kind = "agent"
 		case strings.TrimSpace(pj.Magpie.Page.File) != "":
 			t.Kind = "page"
+		// a gateway request hook alone (magpie.hooks, as gateway.go's
+		// Gateway takes it) has no entry file to load either: without
+		// this it falls through to index.js, which it hasn't, and is
+		// dropped from the list (#3821)
+		case strings.TrimSpace(pj.Magpie.Hooks) != "":
+			t.Kind = "middleware"
 		}
 	}
 	// published to npm from this repository: npm's copy is the one
