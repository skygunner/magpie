From 0bbb64eea0e83cac927480fd4e6cddf1cb39a753 Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:44:40 +1000
Subject: [PATCH 2/3] edit: an inline object stays inline only for an object
 magpie adds (#3814)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The span rule as committed also compacted scalars added to an inline
object, which took the spacing the user's file had away from the keys
magpie puts back on disconnect (TestAgentModelDefaultKeepsTheEndpointBefore
caught it). An object the user keeps on one line stays on that line when
what magpie adds there is an object of its own — the subtree is the unit
the user laid out; a scalar goes on its own line in the file's style.
---
 internal/edit/json.go | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/internal/edit/json.go b/internal/edit/json.go
index 8252fbc1..f1a31781 100644
--- a/internal/edit/json.go
+++ b/internal/edit/json.go
@@ -52,8 +52,7 @@ func SetJSON(path string, kvs ...KV) error {
 		return err
 	}
 	if len(bytes.TrimSpace(raw)) == 0 {
-		// a new file is laid out over lines, so insertKey keeps to that style
-		raw = []byte("{\n}\n")
+		raw = []byte("{}\n")
 	}
 	orig := raw
 	for _, kv := range kvs {
@@ -179,9 +178,14 @@ func insertKey(raw, stripped []byte, from int, key string, value any) ([]byte, e
 		return nil, fmt.Errorf("cannot locate object for %q", key)
 	}
 	k, _ := json.Marshal(key)
-	// The target object's own span decides: an object the user keeps on one
-	// line is added to on that line, however the rest of the file is laid out.
-	pretty := bytes.IndexByte(raw[open:close+1], '\n') >= 0
+	// An object the user keeps on one line stays on that line when what
+	// magpie adds to it is an object of its own (#3814): the subtree is the
+	// unit the user laid out. A scalar goes on its own line in the file's
+	// style, as the file's other scalars are.
+	pretty := bytes.IndexByte(raw, '\n') >= 0
+	if _, isObj := value.(map[string]any); isObj && bytes.IndexByte(raw[open:close+1], '\n') < 0 {
+		pretty = false
+	}
 	empty := len(bytes.TrimSpace(raw[open+1:close])) == 0
 
 	if !pretty {
-- 
