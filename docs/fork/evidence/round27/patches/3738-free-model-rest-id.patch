From 499f0249ac8820b9c032264005a233d7dc9d3351 Mon Sep 17 00:00:00 2001
From: vincent <vincent@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:47:16 +1000
Subject: [PATCH 2/2] gateway: FreeModel is asked only when there is a window
 to override (#3738)

candidate.full is on the searcher's model-pick path, where its allocation
test counts: FreeModel walks the provider's list and asks its price, and
asking it for every candidate whether or not there was a window to
override pushed TestAutoVisionDoesNotBuildListsAgain over its count.
The rest is the same: a free model's own window is zero either way.
---
 internal/gateway/routing.go | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/internal/gateway/routing.go b/internal/gateway/routing.go
index 44e7bb68..104ca86a 100644
--- a/internal/gateway/routing.go
+++ b/internal/gateway/routing.go
@@ -1373,11 +1373,14 @@ func (c candidate) full(now time.Time) time.Time {
 	}
 	// a free model shares an account-wide free quota only, so its own
 	// failure does not ride the account's window: a free model's
-	// allowance used up rests the model, not the account (#3738).
-	if c.p.FreeModel(c.model) {
+	// allowance used up rests the model, not the account (#3738). FreeModel
+	// is asked only when there is a window to override: the searcher's
+	// model pick calls this per candidate, and its allocation test counts.
+	full := a.Full(c.model, provider.SpentShareOf(c.p.Routing), now)
+	if !full.IsZero() && c.p.FreeModel(c.model) {
 		return time.Time{}
 	}
-	return a.Full(c.model, provider.SpentShareOf(c.p.Routing), now)
+	return full
 }
 
 // onCredits: c is a Codex account that goes on past its allowance on its
